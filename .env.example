# API
PORT=3333
API_TOKEN=troque-por-um-token-longo-com-pelo-menos-32-caracteres
CORS_ORIGIN=http://localhost:5173
TZ=America/Sao_Paulo

# PostgreSQL (docker-compose.yml sobe um para desenvolvimento)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contatos
POSTGRES_USER=contatos
POSTGRES_PASSWORD=troque-por-uma-senha

# Bloqueio por token errado (5 erros = 10 min por IP). Cabecalho com o IP real do cliente, que o
# proxy deve sobrescrever (ex.: CF-Connecting-IP ou X-Real-IP). Vazio usa o IP da conexao.
CLIENT_IP_HEADER=
