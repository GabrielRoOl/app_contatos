#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot: copiar para ~/.termux/boot/40-contatos. Sobe depois do site, do aura e do contador.
LOG="$HOME/logs/boot-contatos.log"
mkdir -p "$HOME/logs"
echo "$(date '+%F %T') boot: aguardando 60 s" >> "$LOG"
sleep 60
"$HOME/contatos/contatos.sh" start >> "$LOG" 2>&1
echo "$(date '+%F %T') boot: contatos.sh start terminou (codigo $?)" >> "$LOG"
